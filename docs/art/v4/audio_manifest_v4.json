{
  "project": "PULSE",
  "version": "4.0.0",
  "recommendedFormat": {
    "music": "OGG Vorbis (.ogg) for all streaming background tracks; WAV masters (.wav) also included for short stings",
    "sfx": "OGG Vorbis (.ogg) for general WebAudio playback; 16-bit 44.1kHz PCM WAV (.wav) masters included for zero-latency critical cues"
  },
  "mixAndPolyphonyGuidance": {
    "musicMasterVolume": 0.55,
    "sfxMasterVolume": 0.85,
    "shrinkLoopVolume": 0.25,
    "maxSimultaneousSfx": 6,
    "mobileAudioUnlockStrategy": "Call scene.sound.unlock() and resume WebAudio AudioContext inside the first pointerdown event handler; listen to game.events 'blur'/'hidden' to pause active music loops and 'focus'/'visible' to resume."
  },
  "hookMappingToExistingSfxJs": {
    "start": "sfx_ui_retry",
    "pass": "sfx_obstacle_gate_pass",
    "pickup": "sfx_pickup_gold",
    "bonusPickup": "sfx_pickup_mint_bonus",
