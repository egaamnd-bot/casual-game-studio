    "crash": "sfx_player_death_collision",
    "chargedFail": "sfx_barrier_charged_fail",
    "milestone": "sfx_multiplier_max_x5",
    "smash": "sfx_barrier_smash_ordinary",
    "chargedSmash": "sfx_barrier_smash_charged",
